# 生产环境配置模板 - 复制为 .env 并填写真实值
# ⚠️  不要将此文件中的真实密钥提交到版本控制

# Server
PORT=3000
NODE_ENV=production

# Database（PostgreSQL）
DB_USER=babycry
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql://babycry:CHANGE_ME_STRONG_PASSWORD@db:5432/baby_cry_app

# JWT
JWT_SECRET=CHANGE_ME_AT_LEAST_64_CHARS_RANDOM_STRING
JWT_EXPIRES_IN=7d

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=info

# CORS（限制到你的移动 App bundle ID）
ALLOWED_ORIGINS=exp://,com.dingxli.babycryapp://
